{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "akashmunshi-com",
  "account_id": "30f32e276133216ae8ff40e13d55bb48",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "akashmunshi-ari42",
      "database_id": "762330e3-46b9-43e0-baae-6ea15c668fbd",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    { "pattern": "akashmunshi.com", "custom_domain": true },
    { "pattern": "www.akashmunshi.com", "custom_domain": true }
  ],
  "workers_dev": true
}
